<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Custom Redirect Appender -->
    <appender name="REDIRECT" class="nl.gmt.rollbase.logging.RedirectAppender">
        <encoder>
            <pattern>[%level] %msg (%logger)%n</pattern>
        </encoder>
    </appender>

    <!-- Root Logger -->
    <root level="WARN">
        <appender-ref ref="REDIRECT" />
    </root>
</configuration>
